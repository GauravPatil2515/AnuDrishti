# DeNovo Ignore Patterns
# =======================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
ENV/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Jupyter
.ipynb_checkpoints/

# Node.js (frontend)
frontend/node_modules/
frontend/build/
frontend/.env

# Model weights (large files - keep only essential ones)
# Uncomment to exclude model files from git
# *.pth
# *.pkl
checkpoint_*.pth
*.ckpt

# Temporary files
*.tmp
*.temp
.cache/

# Docker
*.log

# Overleaf backups
overleaf/*.aux
overleaf/*.bbl
overleaf/*.blg
overleaf/*.fdb_latexmk
overleaf/*.fls
overleaf/*.synctex.gz
overleaf/*.out

# Zip files (generated)
*.zip

# Model Checkpoints
checkpoints/
*.pt

# Raw data CSVs (large, kept local only)
model-training/data/raw/*.csv

# Jupyter notebooks (not part of the reproducible pipeline)
*.ipynb
.ipynb_checkpoints/

# Hermes plan scratch
.hermes/
