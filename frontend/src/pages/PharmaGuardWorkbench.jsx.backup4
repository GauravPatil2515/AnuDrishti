import React, { useState, useEffect, useRef, useCallback } from 'react';
import api from '../api';
import { clsx } from 'clsx';
import { toast } from 'react-hot-toast';
import {
  BeakerIcon, SwatchIcon, ShieldCheckIcon, MagnifyingGlassIcon,
  TableCellsIcon, SparklesIcon, PlayIcon, InformationCircleIcon
} from '@heroicons/react/24/outline';
import MolecularInput from '../components/MolecularInput';
import MolecularExplorer from '../components/MolecularExplorer';
import SafetyDashboard from '../components/SafetyDashboardWrapper';
import ExplanationAudit from '../components/ExplanationAudit';
import LibraryScreening from '../components/LibraryScreening';
import WhatIfOptimizer from '../components/WhatIfOptimizer';
import PipelineProgress from '../components/PipelineProgress';
import BenchmarkTab from '../components/BenchmarkTab';
import { useAnalysis } from '../App';

const TABS = [
  { id: 'input', label: 'Input', icon: BeakerIcon },
  { id: 'explorer', label: 'Explorer', icon: SwatchIcon },
  { id: 'safety', label: 'Safety', icon: ShieldCheckIcon },
  { id: 'audit', label: 'Audit', icon: MagnifyingGlassIcon },
  { id: 'library', label: 'Library', icon: TableCellsIcon },
  { id: 'whatif', label: 'What-If', icon: SparklesIcon },
  { id: 'benchmark', label: 'Benchmark', icon: PlayIcon }
];

const DemoResults = ({ results }) => {
  return (
    <div className="space-y-4 animate-fade-in">
      <div className="rounded-xl border border-accent-amber/30 bg-accent-amber/5 p-4 text-xs text-accent-amber flex items-start gap-3">
        <InformationCircleIcon className="h-5 w-5 shrink-0" />
        <p>
          These are <strong>illustrative demo records</strong> (a benign drug and a known
          toxicant) so you can experience the full triage + faithfulness workflow instantly.
        </p>
      </div>
      {results.map((r, i) => (
        <div key={i} className="surface p-5 hover:shadow-card-hover transition-all duration-200">
          <p className="mb-4 font-mono text-xs text-text-muted break-all p-2 bg-canvas rounded border border-border">{r.smiles}</p>
          <SafetyDashboard analysis={r} />
        </div>
      ))}
    </div>
  );
};

const CommandPalette = ({ isOpen, onClose, activeTab, onTabSelect, onQuickAction, searchRef }) => {
  const [search, setSearch] = useState('');

  useEffect(() => {
    if (isOpen) {
      setTimeout(() => searchRef?.current?.focus(), 100);
    }
  }, [isOpen, searchRef]);

  const filteredTabs = TABS.filter(t =>
    t.label.toLowerCase().includes(search.toLowerCase())
  );

  const quickActions = [
    { label: 'Load Demo', action: 'demo', shortcut: '↵' },
    { label: 'Export PDF Report', action: 'export', shortcut: '⌘E' },
    { label: 'Simulate Hallucination', action: 'hallucinate', shortcut: '⌘H' }
  ];

  const filteredActions = quickActions.filter(a =>
    a.label.toLowerCase().includes(search.toLowerCase())
  );

  if (!isOpen) return null;

  return (
    <div className="fixed inset-0 z-50 flex items-start justify-center pt-20 px-4" onClick={onClose}>
      <div className="fixed inset-0 bg-canvas/80 backdrop-blur-sm" />
      <div
        className="relative w-full max-w-lg rounded-xl border border-border bg-surface shadow-dropdown overflow-hidden z-10"
        onClick={e => e.stopPropagation()}
      >
        <div className="px-4 pt-3 pb-2 border-b border-border">
          <input
            ref={searchRef}
            type="text"
            value={search}
            onChange={(e) => setSearch(e.target.value)}
            placeholder="Type a command or search tabs..."
            className="w-full bg-transparent border-0 text-sm text-text-primary placeholder:text-text-muted focus:outline-none"
            autoFocus
          />
        </div>
        <div className="px-4 pb-4 space-y-2">
          <div className="border-t border-border pt-4">
            <div className="font-semibold text-text-primary mb-2">Tabs</div>
            <div className="space-y-1 text-xs">
              {filteredTabs.map((t) => (
                <div
                  key={t.id}
                  onClick={() => {
                    onTabSelect(t.id);
                    onClose();
                  }}
                  className={clsx(
                    'flex items-center gap-2 px-3 py-2 rounded-md transition-colors duration-150',
                    activeTab === t.id
                      ? 'bg-accent-green/10 text-accent-green'
                      : 'hover:bg-surface-hover'
                  )}
                >
                  <t.icon className="h-4 w-4 flex-shrink-0" />
                  <span>{t.label}</span>
                </div>
              ))}
            </div>
          </div>
          {filteredActions.length > 0 && (
            <>
              <div className="border-t border-border pt-4">
                <div className="font-semibold text-text-primary mb-2">Actions</div>
                <div className="space-y-1 text-xs">
                  {filteredActions.map((a) => (
                    <div
                      key={a.label}
                      onClick={() => {
                        onQuickAction(a.action);
                        onClose();
                      }}
                      className="flex items-center gap-2 px-3 py-2 rounded-md transition-colors duration-150 hover:bg-surface-hover"
                    >
                      <span className="font-mono">{a.shortcut}</span>
                      <span>{a.label}</span>
                    </div>
                  ))}
                </div>
              </div>
            </>
          )}
        </div>
      </div>
    </div>
  );
};

const PharmaGuardWorkbench = () => {
  const { addAnalysis, lastAnalysis } = useAnalysis();
  const [activeTab, setActiveTab] = useState('input');
  const [analysis, setAnalysis] = useState(() => lastAnalysis || null);
  const [batchResult, setBatchResult] = useState(null);
  const [whatif, setWhatif] = useState(null);
  const [loading, setLoading] = useState(false);
  const [demoResults, setDemoResults] = useState(null);
  const [demoLoading, setDemoLoading] = useState(false);
  const [cmdPaletteOpen, setCmdPaletteOpen] = useState(false);
  const cmdInputRef = useRef(null);
  const analysisRef = useRef(null);

  // Sync with context
  useEffect(() => {
    if (lastAnalysis && lastAnalysis !== analysis) {
      setAnalysis(lastAnalysis);
    }
  }, [lastAnalysis, analysis]);

  // Handle analysis completion
  const handleAnalysisComplete = useCallback((results) => {
    // Store in context
    addAnalysis(results);
    
    // Update local state
    setAnalysis(results);
    
    // Show success toast
    toast.success('Analysis complete! Results are ready for review.', {
      duration: 3000
    });
  }, [addAnalysis]);

  // Handle batch analysis
  const handleBatchAnalysis = useCallback(async (smilesList) => {
    setLoading(true);
    try {
      const res = await api.post('/api/predict/batch', { smiles_list: smilesList });
      setBatchResult(res.data);
      toast.success(`Batch analysis complete! Processed ${smilesList.length} molecules.`, {
        duration: 3000
      });
    } catch (err) {
      toast.error('Batch analysis failed. Please try again.');
      console.error('Batch analysis error:', err);
    } finally {
      setLoading(false);
    }
  }, []);

  // Handle what-if analysis
  const handleWhatIfAnalysis = useCallback(async (smiles) => {
    setLoading(true);
    try {
      const res = await api.post('/api/whatif/optimize', { smiles });
      setWhatif(res.data);
      toast.success('What-if analysis complete! Optimized variants generated.', {
        duration: 3000
      });
    } catch (err) {
      toast.error('What-if analysis failed. Please try again.');
      console.error('What-if error:', err);
    } finally {
      setLoading(false);
    }
  }, []);

  // Handle demo load
  const handleLoadDemo = useCallback(async () => {
    setDemoLoading(true);
    try {
      const res = await api.get('/api/demo/results');
      setDemoResults(res.data);
    } catch (err) {
      console.error('Demo load error:', err);
      // Fallback demo data
      setDemoResults([
        {
          smiles: "CC(=O)OC1=CC=CC=C1C(=O)O",
          prediction: 0.15,
          confidence: 0.92,
          explanation: "Aspirin shows low toxicity predicted by the model.",
          evidence: ["GT score: -2.1", "Attention focused on carboxyl groups"]
        },
        {
          smiles: "c1ccc(cc1)C2=CC(=NN2C3=CC=CC=C3C=O)O",
          prediction: 0.87,
          confidence: 0.89,
          explanation: "This compound shows high toxicity risk requiring careful review.",
          evidence: ["GT score: 1.8", "Structural alerts for aromatic amines"]
        }
      ]);
    } finally {
      setDemoLoading(false);
    }
  }, []);

  // Handle tab change
  const handleTabChange = useCallback((tabId) => {
    setActiveTab(tabId);
    // Close command palette if open
    if (cmdPaletteOpen) setCmdPaletteOpen(false);
  }, [cmdPaletteOpen]);

  // Handle quick actions from command palette
  const handleQuickAction = useCallback((action) => {
    switch (action) {
      case 'demo':
        handleLoadDemo();
        break;
      case 'export':
        if (analysis) {
          toast.info('PDF export feature coming soon!');
        } else {
          toast.warning('No analysis data to export. Run an analysis first.');
        }
        break;
      case 'hallucinate':
        toast.info('Hallucination simulation feature coming soon!');
        break;
      default:
        break;
    }
    // Close command palette
    if (cmdPaletteOpen) setCmdPaletteOpen(false);
  }, [analysis, handleLoadDemo, cmdPaletteOpen]);

  // Handle key shortcuts
  useEffect(() => {
    const handleKeyDown = (e) => {
      // ⌘K to open command palette
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        setCmdPaletteOpen(true);
      }
      // Escape to close command palette
      if (e.key === 'Escape' && cmdPaletteOpen) {
        setCmdPaletteOpen(false);
      }
    };

    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, [cmdPaletteOpen]);

  // Handle outside click to close command palette
  useEffect(() => {
    if (!cmdPaletteOpen) return;

    const handleClickOutside = (e) => {
      if (analysisRef.current && !analysisRef.current.contains(e.target)) {
        setCmdPaletteOpen(false);
      }
    };

    document.addEventListener('mousedown', handleClickOutside);
    return () => document.removeEventListener('mousedown', handleClickOutside);
  }, [cmdPaletteOpen]);

  // Auto-focus input when tab changes to input
  useEffect(() => {
    if (activeTab === 'input') {
      // Focus will be handled by MolecularInput component
    }
  }, [activeTab]);

  return (
    <div ref={analysisRef} className="p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto space-y-6">
      <CommandPalette
        isOpen={cmdPaletteOpen}
        onClose={() => setCmdPaletteOpen(false)}
        activeTab={activeTab}
        onTabSelect={setActiveTab}
        onQuickAction={handleQuickAction}
        searchRef={cmdInputRef}
      />

      {/* Tab Navigation & Info Bar Header */}
      <div className="surface p-2 flex flex-col sm:flex-row items-center justify-between gap-3 shadow-sm">
        <div className="inline-flex items-center gap-1 rounded-xl bg-surface/80 p-1.5 border border-border/60 backdrop-blur-md overflow-x-auto w-full sm:w-auto hide-scrollbar">
          {TABS.map((t) => {
            const Icon = t.icon;
            return (
              <button
                key={t.id}
                onClick={() => handleTabChange(t.id)}
                className={clsx(
                  'flex items-center gap-2 rounded-lg px-3.5 py-2 text-xs font-semibold transition-all duration-150 whitespace-nowrap',
                  activeTab === t.id
                    ? 'bg-accent-green text-white shadow-sm'
                    : 'text-text-secondary hover:text-text-primary hover:bg-surface-hover'
                )}
              >
                <Icon className="h-4 w-4" />
                <span>{t.label}</span>
              </button>
            );
          })}
        </div>

        <div className="hidden md:flex items-center gap-2 text-xs text-text-muted px-2">
          <span>Press</span>
          <kbd className="px-1.5 py-0.5 rounded border border-border bg-surface-elevated font-mono text-[10px] font-bold text-text-primary">⌘K</kbd>
          <span>for command palette</span>
        </div>
      </div>

      {/* MAIN CONTENT AREA */}
      {!analysis && !batchResult && !whatif && !demoLoading && !demoResults ? (
        // Show placeholder when no analysis has been run
        <div className="text-center py-12">
          <div className="h-16 w-16 rounded-2xl bg-accent-green/10 text-accent-green flex items-center justify-center mb-4 shadow-glow-green">
            <BeakerIcon className="h-8 w-8" />
          </div>
          <h2 className="text-2xl font-bold font-display text-text-primary mb-2">Ready to analyze molecules</h2>
          <p className="text-sm text-text-muted max-w-md mb-6">
            Enter a drug name or SMILES string above to get started with toxicity prediction and explanation.
          </p>
          <div className="flex justify-center space-x-4">
            <button
              onClick={handleLoadDemo}
              disabled={demoLoading}
              className={clsx(
                'btn btn-outline px-6 py-3 text-sm font-medium transition-all duration-200',
                demoLoading
                  ? 'opacity-50 cursor-not-allowed'
                  : 'hover:bg-accent-green/10 hover:text-accent-green'
              )}
            >
              {demoLoading ? 'Loading demo...' : 'Try with demo data'}
            </button>
          </div>
        </div>
      ) : (
        <>
          {/* SHOW RESULTS PROMINENTLY WHEN AVAILABLE */}
          {(analysis || batchResult || whatif || demoResults) && (
            <div className="space-y-6">
              {/* Single Molecule Results */}
              {analysis && !batchResult && !whatif && !demoResults && (
                <div>
                  <div className="surface p-6 rounded-xl border border-accent-green/20">
                    <h3 className="mb-4 text-xl font-bold text-text-primary flex items-center gap-2">
                      <ShieldCheckIcon className="h-5 w-5" />
                      Analysis Complete
                    </h3>
                    <div className="space-y-4">
                      <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                        <div className="surface p-4">
                          <h4 className="mb-2 text-xs font-bold text-accent-green uppercase tracking-wider">Prediction</h4>
                          <p className="text-2xl font-mono text-text-primary">
                            {analysis.prediction !== undefined 
                              ? `${(analysis.prediction * 100).toFixed(1)}%` 
                              : 'N/A'}
                          </p>
                          <p className="text-xs text-text-muted mt-1">
                            Toxicity probability
                          </p>
                        </div>
                        <div className="surface p-4">
                          <h4 className="mb-2 text-xs font-bold text-accent-green uppercase tracking-wider">Confidence</h4>
                          <p className="text-2xl font-mono text-text-primary">
                            {analysis.confidence !== undefined 
                              ? `${(analysis.confidence * 100).toFixed(1)}%` 
                              : 'N/A'}
                          </p>
                          <p className="text-xs text-text-muted mt-1">
                            Model certainty
                          </p>
                        </div>
                        <div className="surface p-4">
                          <h4 className="mb-2 text-xs font-bold text-accent-green uppercase tracking-wider">Risk Level</h4>
                          <p className="text-2xl font-mono text-text-primary capitalize">
                            {analysis.prediction !== undefined 
                              ? analysis.prediction >= 0.7
                                ? 'High'
                                : analysis.prediction >= 0.3
                                  ? 'Medium'
                                  : 'Low'
                              : 'N/A'}
                          </p>
                          <p className="text-xs text-text-muted mt-1">
                            Based on prediction threshold
                          </p>
                        </div>
                        <div className="surface p-4">
                          <h4 className="mb-2 text-xs font-bold text-accent-green uppercase tracking-wider">Safety</h4>
                          <p className="text-2xl font-mono text-text-primary capitalize">
                            {analysis.prediction !== undefined 
                              ? analysis.prediction >= 0.7
                                ? 'Toxic'
                                : 'Safe'
                              : 'N/A'}
                          </p>
                          <p className="text-xs text-text-muted mt-1">
                            Safety assessment
                          </p>
                        </div>
                      </div>
                      
                      {/* Explanation Preview */}
                      {analysis.explanation && (
                        <div className="surface p-4">
                          <h4 className="mb-2 text-xs font-bold text-accent-green uppercase tracking-wider">Explanation</h4>
                          <p className="text-sm text-text-muted leading-relaxed">
                            {analysis.explanation}
                          </p>
                        </div>
                      )}
                      
                      {/* Evidence Preview */}
                      {analysis.evidence && analysis.evidence.length > 0 && (
                        <div className="surface p-4">
                          <h4 className="mb-2 text-xs font-bold text-accent-green uppercase tracking-wider">Evidence</h4>
                          <div className="space-y-2 text-xs">
                            {analysis.evidence.slice(0, 3).map((ev, idx) => (
                              <div key={idx} className="flex items-start gap-2">
                                <div className="h-2.5 w-2.5 rounded-full bg-accent-green/20 text-accent-green flex items-center justify-center text-xs font-mono">
                                  •
                                </div>
                                <span>{ev}</span>
                              </div>
                            ))}
                            {analysis.evidence.length > 3 && (
                              <div className="text-xs text-text-muted italic mt-2">
                                +{analysis.evidence.length - 3} more
                              </div>
                            )}
                          </div>
                        </div>
                      )}
                    </div>
                  
                  {/* Action Buttons */}
                  <div className="flex flex-wrap gap-3 mt-6">
                    <button
                      onClick={() => setActiveTab('explorer')}
                      className={clsx(
                        'btn btn-outline px-5 py-3 text-sm font-medium transition-all duration-200 hover:bg-accent-green/10 hover:text-accent-green flex-1 sm:auto',
                        demoLoading
                          ? 'opacity-50 cursor-not-allowed'
                          : ''
                      )}
                    >
                      {demoLoading ? 'Loading...' : 'Load Demo Data'}
                    </button>
                    <button
                      onClick={() => setActiveTab('safety')}
                      className={clsx(
                        'btn btn-outline px-5 py-3 text-sm font-medium transition-all duration-200 hover:bg-accent-green/10 hover:text-accent-green flex-1 sm:auto',
                        demoLoading
                          ? 'opacity-50 cursor-not-allowed'
                          : ''
                      )}
                    >
                      {demoLoading ? 'Loading...' : 'Load Demo Data'}
                    </button>
                    <button
                      onClick={() => setActiveTab('audit')}
                      className={clsx(
                        'btn btn-outline px-5 py-3 text-sm font-medium transition-all duration-200 hover:bg-accent-green/10 hover:text-accent-green flex-1 sm:auto',
                        demoLoading
                          ? 'opacity-50 cursor-not-allowed'
                          : ''
                      )}
                    >
                      {demoLoading ? 'Loading...' : 'Load Demo Data'}
                    </button>
                  </div>
                </div>
                </div>
              )}
              
              {/* Batch Results */}
              {batchResult && !analysis && !whatif && !demoResults && (
                <div>
                  <div className="surface p-6 rounded-xl border border-accent-blue/20">
                    <h3 className="mb-4 text-xl font-bold text-text-primary flex items-center gap-2">
                      <TableCellsIcon className="h-5 w-5" />
                      Batch Analysis Complete
                    </h3>
                    <p className="mb-4 text-sm text-text-muted">
                      Processed {batchResult.length} molecules. View detailed results in the Library Screening tab.
                    </p>
                    <div className="space-y-3">
                      {batchResult.slice(0, 5).map((mol, idx) => (
                        <div key={idx} className="surface p-4">
                          <div className="flex justify-between items-start mb-2">
                            <span className="font-mono text-xs">{mol.smiles}</span>
                            <span className={clsx(
                              'px-2 py-1 rounded text-xs font-mono',
                              mol.prediction >= 0.7
                                ? 'bg-accent-rose/20 text-accent-rose'
                                : mol.prediction >= 0.3
                                  ? 'bg-accent-amber/20 text-accent-amber'
                                  : 'bg-accent-emerald/20 text-accent-emerald'
                            )}>
                              {((mol.prediction || 0) * 100).toFixed(1)}%
                            </span>
                          </div>
                          <p className="text-xs text-text-muted">
                            {mol.explanation || 'No explanation available'}
                          </p>
                        </div>
                      ))}
                      {batchResult.length > 5 && (
                        <div className="text-center text-xs text-muted mt-4">
                          and {batchResult.length - 5} more molecules...
                        </div>
                      )}
                    </div>
                    <div className="mt-6">
                      <button
                        onClick={() => setActiveTab('library')}
                        className="btn btn-primary px-6 py-3 text-sm font-medium"
                      >
                        <TableCellsIcon className="h-4 w-4 mr-2" />
                        View All Results
                      </button>
                    </div>
                  </div>
                </div>
              )}
              
              {/* What-If Results */}
              {whatif && !analysis && !batchResult && !demoResults && (
                <div>
                  <div className="surface p-6 rounded-xl border border-accent-purple/20">
                    <h3 className="mb-4 text-xl font-bold text-text-primary flex items-center gap-2">
                      <SparklesIcon className="h-5 w-5" />
                      What-If Analysis Complete
                    </h3>
                    <p className="mb-4 text-sm text-text-muted">
                      Generated {whatif.variants?.length || 0} optimized variants. View details in the What-If tab.
                    </p>
                    {whatif.original && (
                      <div className="surface p-4 mb-4">
                        <h4 className="mb-2 text-xs font-bold text-accent-purple uppercase tracking-wider">Original Molecule</h4>
                        <div className="space-y-2">
                          <p className="font-mono text-xs text-text-muted break-all">{whatif.original.smiles}</p>
                          <div className="flex gap-2">
                            <span className="px-2 py-1 rounded text-xs font-mono bg-accent-purple/20 text-accent-purple">
                              Risk: {((whatif.original.prediction || 0) * 100).toFixed(1)}%
                            </span>
                            <span className="px-2 py-1 rounded text-xs font-mono bg-accent-purple/20 text-accent-purple">
                              Confidence: {((whatif.original.confidence || 0) * 100).toFixed(1)}%
                            </span>
                          </div>
                        </div>
                      )}
                    }
                    {whatif.variants && whatif.variants.length > 0 && (
                      <div className="surface p-4">
                        <h4 className="mb-2 text-xs font-bold text-accent-purple uppercase tracking-wider">Top Variants</h4>
                        <div className="space-y-3">
                          {whatif.variants.slice(0, 3).map((variant, idx) => (
                            <div key={idx} className="surface p-3">
                              <div className="flex justify-between items-start mb-1">
                                <span className="font-mono text-xs">{variant.smiles}</span>
                                <span className={clsx(
                                  'px-2 py-1 rounded text-xs font-mono',
                                  variant.prediction >= 0.7
                                    ? 'bg-accent-rose/20 text-accent-rose'
                                    : variant.prediction >= 0.3
                                      ? 'bg-accent-amber/20 text-accent-amber'
                                      : 'bg-accent-emerald/20 text-accent-emerald'
                              )}>
                                {((variant.prediction || 0) * 100).toFixed(1)}%
                              </span>
                            </div>
                            <p className="text-xs text-text-muted">
                              {variant.explanation || 'Optimized for lower toxicity'}
                            </p>
                          </div>
                        )}
                        {whatif.variants.length > 3 && (
                          <div className="text-center text-xs text-muted mt-2">
                            and {whatif.variants.length - 3} more variants...
                          </div>
                        )}
                      </div>
                    )}
                    <div className="mt-6">
                      <button
                        onClick={() => setActiveTab('whatif')}
                        className="btn btn-primary px-6 py-3 text-sm font-medium"
                      >
                        <SparklesIcon className="h-4 w-4 mr-2" />
                        Explore Variants
                      </button>
                    </div>
                  </div>
                </div>
              )}
              
              {/* Demo Results */}
              {demoResults && !analysis && !batchResult && !whatif && (
                <DemoResults results={demoResults} />
              )}
            </div>
          )}
          
          {/* TABS FOR ADVANCED EXPLORATION */}
          <div className="space-y-6">
            {/* Input Tab (always visible for new analyses) */}
            {activeTab === 'input' && (
              <MolecularInput 
                onAnalyze={handleAnalysisComplete} 
                onBatchAnalyze={handleBatchAnalysis}
                onWhatIfAnalyze={handleWhatIfAnalysis}
                isLoading={loading}
              />
            )}
            
            {/* Explorer Tab */}
            {activeTab === 'explorer' && analysis && (
              <MolecularExplorer 
                analysis={analysis} 
                onAnalyze={handleAnalysisComplete}
              />
            )}
            
            {/* Safety Dashboard Tab */}
            {activeTab === 'safety' && analysis && (
              <SafetyDashboard 
                analysis={analysis} 
              />
            )}
            
            {/* Explanation Audit Tab */}
            {activeTab === 'audit' && analysis && (
              <ExplanationAudit 
                analysis={analysis} 
              />
            )}
            
            {/* Library Screening Tab */}
            {activeTab === 'library' && batchResult && (
              <LibraryScreening 
                results={batchResult} 
              />
            )}
            
            {/* What-If Tab */}
            {activeTab === 'whatif' && whatif && (
              <WhatIfOptimizer 
                result={whatif} 
                onAnalyze={handleAnalysisComplete}
              />
            )}
            
            {/* Benchmark Tab */}
            {activeTab === 'benchmark' && (
              <BenchmarkTab />
            )}
          </>
        </>
      )}
      
      {/* Loading State Overlay */}
      {loading || demoLoading && (
        <div className="fixed inset-0 bg-canvas/50 backdrop-blur-sm flex items-center justify-center z-50">
          <div className="surface p-6 rounded-xl text-center space-y-4">
            <div className="h-12 w-12 rounded-full bg-accent-green/20 text-accent-green flex items-center justify-center mb-4">
              {loading ? <BeakerIcon className="h-6 w-6 animate-spin" /> : <PlayIcon className="h-6 w-6" />}
            </div>
            <h3 className="text-xl font-bold text-text-primary">{loading ? 'Analyzing...' : 'Loading demo data...'}</h3>
            <p className="text-sm text-text-muted">
              Please wait while we process your request.
            </p>
          </div>
        </div>
      )}
    </div>
  );
};

export default PharmaGuardWorkbench;